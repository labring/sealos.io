      {
        "variableId": "810110",
        "name": "Sealos Website Acquisition | Scope",
        "type": "jsm",
        "parentFolderId": "810000",
        "parameter": [
          {
            "type": "template",
            "key": "javascript",
            "value": "function() {\n  var visitor = {{Sealos Website Acquisition | DLV - visitor_id}};\n  if (location.protocol !== 'https:' || location.port ||\n      (location.hostname !== 'sealos.io' && location.hostname !== 'www.sealos.io') ||\n      {{Sealos Website Acquisition | DLV - surface}} !== 'website' || {{Sealos Website Acquisition | DLV - product_edition}} !== 'global' ||\n      {{Sealos Website Acquisition | DLV - analytics_consent}} !== 'granted' ||\n      !/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i.test(visitor)) return false;\n  try {\n    var match = document.cookie.match(/(?:^|;\\s*)sealos_acquisition_v1=([A-Za-z0-9_-]+)(?:;|$)/);\n    if (!match || match[1].length > 2400) return false;\n    var bytes = atob(match[1].replace(/-/g, '+').replace(/_/g, '/'));\n    if (bytes.length > 1800 || btoa(bytes).replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=+$/, '') !== match[1]) return false;\n    var encoded = '';\n    for (var i = 0; i < bytes.length; i++) encoded += '%' + ('0' + bytes.charCodeAt(i).toString(16)).slice(-2);\n    var current = JSON.parse(decodeURIComponent(encoded));\n    return !!(current && current.version === 1 && current.realm === 'global' && current.visitor_id === visitor &&\n      current.consent && current.consent.analytics_storage === 'granted');\n  } catch (error) { return false; }\n}"
          }
        ]
      }
